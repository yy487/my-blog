---
import { Icon } from "astro-icon/components";
import site from "../data/site.json";
import { commentPath, walineServerURL } from "../utils/interaction-utils";
import "@waline/client/style";
import "../styles/interactions.css";

interface Props {
	title: string;
	url: string;
}

const { title, url } = Astro.props;
const serverURL = walineServerURL(site.walineServerURL);
---

<section
	class="article-interactions card-base mb-4 px-6 py-6 md:px-9"
	data-article-interactions
	data-title={title}
	data-url={url}
	data-pagefind-ignore
	aria-label="文章互动"
>
	<div class="interaction-share-row">
		<div>
			<h2 class="text-lg font-bold text-90">分享这篇文章</h2>
			<p class="mt-1 text-sm text-50">把文章分享给感兴趣的人。</p>
		</div>
		<div class="interaction-actions">
			<button type="button" class="btn-regular interaction-button" data-share-article>
				<Icon name="material-symbols:share-outline" />分享文章
			</button>
			<button type="button" class="btn-regular interaction-button" data-copy-article>
				<Icon name="material-symbols:content-copy-outline" />复制链接
			</button>
		</div>
	</div>
	<p class="interaction-status text-sm text-50" data-share-status role="status" aria-live="polite"></p>
	<input class="interaction-copy-input" data-share-fallback type="url" value={url} readonly aria-label="文章链接，选中后复制" hidden />
	<noscript><p class="mt-3 text-sm text-50">文章链接：<a href={url}>{url}</a></p></noscript>
	{serverURL && (
		<div class="interaction-comments">
			<div class="interaction-like-row">
				<button type="button" class="btn-regular interaction-button" data-like-article aria-pressed="false" disabled>
					<Icon name="material-symbols:favorite-outline-rounded" />
					<span data-like-label>点赞</span><span data-like-count>—</span>
				</button>
				<p class="text-sm text-50" data-like-status role="status" aria-live="polite">喜欢这篇文章的话，点个赞吧。</p>
			</div>
			<h2 class="text-xl font-bold text-90" id="article-comments">评论与交流</h2>
			<p class="mt-2 mb-5 text-sm text-50">登录后可以评论或回复。评论需经瑜瑜审核后公开显示。</p>
			<div
				data-waline
				data-server={serverURL}
				data-path={commentPath(url)}
				data-turnstile={site.walineTurnstileKey || ""}
				aria-labelledby="article-comments"
			></div>
			<p class="text-sm text-50" data-comments-status role="status" aria-live="polite">评论区正在加载…</p>
			<button type="button" class="btn-regular interaction-button mt-3" data-comments-retry hidden>重新加载互动</button>
			<noscript><p class="text-sm text-50">启用 JavaScript 后可以查看评论、点赞或参与讨论。</p></noscript>
		</div>
	)}
</section>

<script>
	import "../scripts/article-interactions";
</script>
