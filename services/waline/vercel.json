{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "github": { "silent": true },
  "env": { "NODE_OPTIONS": "--experimental-require-module" },
  "builds": [
    { "src": "robots.txt", "use": "@vercel/static" },
    {
      "src": "index.cjs",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "node_modules/@mathjax/mathjax-tex-font/**/*",
          "node_modules/mhchemparser/**/*",
          "node_modules/ip2region/data/**"
        ]
      }
    }
  ],
  "rewrites": [
    { "source": "/((?!robots\\.txt$).*)", "destination": "index.cjs" }
  ]
}
